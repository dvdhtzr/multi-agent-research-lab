# Copy this file to .env and adjust the values for your local setup.
# .env is gitignored — never commit it.
# All variables use the LAB_ prefix.
#
# The defaults below match a fresh Ollama install with gemma4.
# Most users won't need to change anything.

# -----------------------------------------------------------------------
# Ollama (local inference — no paid API, no cloud dependency)
# -----------------------------------------------------------------------

# Base URL for your locally running Ollama instance.
# Default: http://localhost:11434
LAB_OLLAMA_BASE_URL=http://localhost:11434

# The Ollama model used by all agents.
# Run `ollama list` to see what you have installed.
# Developed and tested against gemma4:latest (9.6 GB).
LAB_DEFAULT_MODEL=gemma4:latest

# -----------------------------------------------------------------------
# Data and storage
# -----------------------------------------------------------------------

# Path to the OHLCV CSV to use. The synthetic sample is checked in.
# To use your private data: place your CSV in data/private/ and point here.
LAB_DATA_PATH=data/synthetic/spy_sample.csv

# SQLite database file. Created automatically on first run.
LAB_DB_PATH=research.db

# -----------------------------------------------------------------------
# Research budget hard limits
#
# These exist specifically for locally-hosted, non-metered Ollama.
# Milestone 2 uses 8 Ollama calls per run; 12 leaves headroom for retries.
#
# WARNING: If you ever adapt this project to use a paid API provider,
# you MUST implement independently-enforced spending ceilings that cannot
# be overridden by any agent decision.  These budget variables alone are
# not sufficient for cost safety with metered providers.
# -----------------------------------------------------------------------
LAB_MAX_OLLAMA_CALLS=12
LAB_MAX_WALL_CLOCK_SECONDS=300
