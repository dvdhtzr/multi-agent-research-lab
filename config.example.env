# Copy this file to .env and adjust the values for your local setup.
# .env is gitignored — never commit it.
# All variables use the LAB_ prefix.
#
# The defaults below match a fresh Ollama install with gemma4.
# Most users won't need to change anything.

# -----------------------------------------------------------------------
# Ollama (local inference — no paid API, no cloud dependency)
# -----------------------------------------------------------------------

# Base URL for your locally running Ollama instance.
# Default: http://localhost:11434
LAB_OLLAMA_BASE_URL=http://localhost:11434

# The Ollama model used by all agents.
# Run `ollama list` to see what you have installed.
# Developed and tested against gemma4:latest (9.6 GB).
LAB_DEFAULT_MODEL=gemma4:latest

# -----------------------------------------------------------------------
# Data and storage
# -----------------------------------------------------------------------

# Path to the OHLCV CSV to use. The synthetic sample is checked in.
# To use your private data: place your CSV in data/private/ and point here.
LAB_DATA_PATH=data/synthetic/spy_sample.csv

# SQLite database file. Created automatically on first run.
LAB_DB_PATH=research.db

# -----------------------------------------------------------------------
# Research budget hard limits
#
# These exist specifically for locally-hosted, non-metered Ollama.
# Milestone 2 uses 8 Ollama calls per run; 12 leaves headroom for retries.
#
# WARNING: If you ever adapt this project to use a paid API provider,
# you MUST implement independently-enforced spending ceilings that cannot
# be overridden by any agent decision.  These budget variables alone are
# not sufficient for cost safety with metered providers.
# -----------------------------------------------------------------------
LAB_MAX_OLLAMA_CALLS=12
LAB_MAX_WALL_CLOCK_SECONDS=300

# -----------------------------------------------------------------------
# Campaign settings (Milestone 3)
# These govern the autonomous multi-run campaign (python -m lab campaign).
# -----------------------------------------------------------------------

# Maximum number of pipeline runs in one campaign.
LAB_MAX_CAMPAIGN_RUNS=5

# Total LLM call budget across ALL runs in a campaign, including retries.
# Default: 60 (5 runs × 12 calls each).
LAB_MAX_CAMPAIGN_CALLS=60

# -----------------------------------------------------------------------
# Replay settings (Milestone 4)
# Walk-forward replay: python -m lab replay
# -----------------------------------------------------------------------

# Number of candles in each walk-forward window.
LAB_REPLAY_WINDOW_SIZE=300

# Candles to advance between consecutive windows.
LAB_REPLAY_STEP_SIZE=60

# Prediction horizons to test simultaneously in each window (JSON array).
# Default: 5, 15, 30, and 60 bars ahead.
LAB_REPLAY_HORIZONS=[5,15,30,60]

# Total LLM call budget across ALL windows in one replay run, including retries.
# Default: 200 (enough for ~40 windows at 5 calls each with headroom for retries).
LAB_MAX_REPLAY_CALLS=200

# -----------------------------------------------------------------------
# Strategy
# Describe the market pattern or hypothesis you want the system to investigate.
# The Researcher agent will translate your description into SMA parameters
# and propose a testable experiment.
#
# Example:
#   LAB_STRATEGY=I believe that when the market opens with a gap up, short-term
#   momentum tends to continue for the first 15-30 minutes.
#
# Inline text (LAB_STRATEGY) or a file path (LAB_STRATEGY_FILE) are both supported.
# CLI --strategy / --strategy-file take precedence over these settings.
# -----------------------------------------------------------------------

# LAB_STRATEGY=Describe your strategy here in a few plain-English sentences
# LAB_STRATEGY_FILE=/path/to/strategy.txt

# -----------------------------------------------------------------------
# Custom researcher prompts
# Override the built-in Researcher instructions without touching source code.
# Leave commented out (or unset) to use the defaults in lab/agents/prompts.py.
#
# Main pipeline + campaign use the first two; replay uses the replay_ variants.
# Point to a plain UTF-8 text file on your machine.
# -----------------------------------------------------------------------

# LAB_RESEARCHER_SYSTEM_FILE=/path/to/my_researcher_system.txt
# LAB_RESEARCHER_PROMPT_FILE=/path/to/my_researcher_prompt.txt
# LAB_REPLAY_RESEARCHER_SYSTEM_FILE=/path/to/my_replay_researcher_system.txt
# LAB_REPLAY_RESEARCHER_PROMPT_FILE=/path/to/my_replay_researcher_prompt.txt

# -----------------------------------------------------------------------
# Comparative evaluation settings (Milestone 5)
# Three-way comparison: python -m lab compare
# Baseline (0 LLM calls) vs Single-agent (1 call/run) vs Multi-agent (~7 calls/run)
# -----------------------------------------------------------------------

# Number of parameter samples for the baseline (random grid) and single-agent arms.
# Default: 50
LAB_COMPARE_N_SAMPLES=50

# Total LLM call budget shared by the single-agent and multi-agent arms.
# The baseline uses 0 calls; single-agent uses 1 per run; multi-agent uses ~7.
# Default: 60 (same as LAB_MAX_CAMPAIGN_CALLS)
LAB_COMPARE_LLM_BUDGET=60
